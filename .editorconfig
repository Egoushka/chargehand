root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
dotnet_sort_system_directives_first = true
# CA1716: names such as IPromptRegistry.Get clash only with Visual Basic keywords; this is a C# code base.
dotnet_diagnostic.CA1716.severity = none
# CA1711: MemoryStack is a stack of memory sources (ADR 0026), not a collection type.
dotnet_diagnostic.CA1711.severity = none

[tests/**.cs]
# Test names are sentences with underscores, and tests call ports through their interfaces on purpose.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1859.severity = none

[src/{Shared,Modules,Runtimes,Hosts}/**.cs]
# ADR 0060: the skeleton's complexity budget. CA1502 reads the threshold from src/CodeMetricsConfig.txt.
dotnet_diagnostic.CA1502.severity = error

[*.md]
trim_trailing_whitespace = false
