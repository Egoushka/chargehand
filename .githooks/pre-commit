#!/bin/sh
# 1. Denylist: blocks the commit if any staged file matches a term in .private-terms.
# 2. Secret scan: gitleaks over the staged changes.
# .private-terms is gitignored: one extended regex per line, case-insensitive, # for comments.
set -eu

root=$(git rev-parse --show-toplevel)
terms="$root/.private-terms"

if [ ! -f "$terms" ]; then
  echo "pre-commit: .private-terms is missing. Copy .private-terms.example and fill it in." >&2
  exit 1
fi

patterns=$(mktemp)
trap 'rm -f "$patterns"' EXIT
grep -vE '^[[:space:]]*(#|$)' "$terms" > "$patterns" || true

# Whole index, not just this commit's diff: a term that slipped in earlier blocks too.
if [ -s "$patterns" ] && hits=$(git grep --cached -n -I -i -E -f "$patterns"); then
  echo "pre-commit: private terms found in staged content:" >&2
  echo "$hits" >&2
  echo "Remove them (CLAUDE.md, Public vs private). Don't bypass with --no-verify." >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (https://github.com/gitleaks/gitleaks)." >&2
  exit 1
fi
gitleaks git --staged --redact --no-banner -v >/dev/null || {
  echo "pre-commit: gitleaks found a secret in staged changes (rerun: gitleaks git --staged -v)." >&2
  exit 1
}
