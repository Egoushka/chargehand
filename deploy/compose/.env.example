# Copy to .env (same folder as compose.yaml) and fill in. .env is gitignored; never commit it.
# Generate a key: openssl rand -hex 32

# Images. Server and runner share one; the session image is read by the runner. Release tags: github.com/Egoushka/chargehand/releases
# Pin by digest after choosing a version: ./pin-digests.sh <version>
CHARGEHAND_IMAGE=ghcr.io/egoushka/chargehand:0.9.3

# Bearer key for every route of the server. Required.
CHARGEHAND_API_KEY=

# The worker's model credential: set exactly one (both is an error). A container has no interactive login, so one of them is needed.
# API billing:
#ANTHROPIC_API_KEY=
# Subscription (from `claude setup-token`):
#CLAUDE_CODE_OAUTH_TOKEN=

# Host port on 127.0.0.1.
#CHARGEHAND_PORT=4300

# Where the server keeps repositories it may read. Unset: a named volume. Set: an absolute path whose owner is uid 1654.
#CHARGEHAND_REPOS_DIR=

# ---- Core + driven only (docker compose --profile driven up -d) ----
# The session image, by digest: the runner refuses a tag. The same value goes in profile.json under driven.images (pin-digests.sh does both).
#CHARGEHAND_SESSION_IMAGE=ghcr.io/egoushka/chargehand-session@sha256:a710fb966e7b2b4aaacd95bd437d98e12b889be159f294fcc140bb26d144e1a7
# Absolute host path for worker clones and checkouts, owned by uid 1654; it must equal worker_root in profile.json.
#CHARGEHAND_WORK_DIR=/srv/chargehand/work
# Bearer key of the runner.
#CHARGEHAND_RUNNER_KEY=
# The credential that pushes chargehand/<run> branches and opens draft pull requests (it must not be able to push the default branch).
#CHARGEHAND_PUSH_TOKEN=
# The engine's socket on the host. Rootless Docker: $XDG_RUNTIME_DIR/docker.sock.
#DOCKER_SOCKET=/var/run/docker.sock
