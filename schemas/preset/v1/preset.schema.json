{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chargehand:schema:preset:v1",
  "title": "chargehand preset, v1",
  "description": "Compiled into an OpenCode agent plus the permission ruleset passed at session creation. Budgets are enforced by the orchestrator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "allowed_actions", "node_kinds", "approval"],
  "properties": {
    "schema": { "const": "preset/v1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "allowed_actions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["answer", "split", "improve", "ask", "deny"] }
    },
    "node_kinds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/node_kind" }
    },
    "critic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ask_above_risk": { "enum": ["low", "medium", "high"] },
        "ask_above_usd": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "model": { "type": "string", "pattern": "^[^/\\s]+/[^\\s#]+(#[a-z]+)?$", "description": "OpenCode provider/model, optional #variant (reasoning effort)." },
    "node_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "opencode_agent", "permissions", "budget"],
      "properties": {
        "model": { "$ref": "#/$defs/model" },
        "opencode_agent": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "array",
          "description": "OpenCode V2 permission ruleset, passed at session creation. Last matching rule wins (see ADR 0006).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "resource", "effect"],
            "properties": {
              "action": { "type": "string", "minLength": 1 },
              "resource": { "type": "string", "minLength": 1 },
              "effect": { "enum": ["allow", "deny", "ask"] }
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_input_tokens", "max_usd"],
          "properties": {
            "max_input_tokens": { "type": "integer", "minimum": 1 },
            "max_usd": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "description": "OpenCode V2 compaction keys.",
          "properties": {
            "auto": { "type": "boolean" },
            "keep_tokens": { "type": "integer", "minimum": 0, "description": "maps to compaction.keep.tokens" },
            "buffer": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
