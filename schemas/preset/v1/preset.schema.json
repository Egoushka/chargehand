{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chargehand:schema:preset:v1",
  "title": "chargehand preset, v1",
  "description": "Compiled into an OpenCode agent plus the permission ruleset passed at session creation. Budgets are enforced by the orchestrator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "allowed_actions", "node_kinds", "approval"],
  "properties": {
    "schema": { "const": "preset/v1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "allowed_actions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["answer", "split", "improve", "ask", "deny"] }
    },
    "node_kinds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/node_kind" }
    },
    "critic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ask_above_risk": { "enum": ["low", "medium", "high"] },
        "ask_above_usd": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "model": { "type": "string", "pattern": "^[^/\\s]+/[^\\s#]+(#[a-z]+)?$", "description": "OpenCode provider/model, optional #variant (reasoning effort)." },
    "node_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "opencode_agent", "permissions", "budget"],
      "properties": {
        "model": { "$ref": "#/$defs/model" },
        "opencode_agent": { "type": "string", "minLength": 1 },
        "checkout": { "type": "boolean", "description": "false: the node needs no repository; it runs in an empty directory under worker_root and intake does not ask for context.repository. Default true." },
        "writes": { "type": "boolean", "description": "true: the node edits files in its own per-run clone and its result is a verified branch (ADR 0035). Default false." },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "description": "How a writing node's change is verified: the timeout of the test command and how many times its failure is fed back to the worker.",
          "properties": {
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "max_fix_rounds": { "type": "integer", "minimum": 0 }
          }
        },
        "permissions": {
          "type": "array",
          "description": "OpenCode V2 permission ruleset, passed at session creation. Last matching rule wins (see ADR 0006).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "resource", "effect"],
            "properties": {
              "action": { "type": "string", "minLength": 1 },
              "resource": { "type": "string", "minLength": 1 },
              "effect": { "enum": ["allow", "deny", "ask"] }
            }
          }
        },
        "services": {
          "type": "array",
          "description": "MCP servers from the profile's mcp_servers whose tools the node's workers may call. Explicit tool names only: a glob is allowed, a bare * (the whole server) is not.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["server", "tools"],
            "properties": {
              "server": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "tools": {
                "type": "array", "minItems": 1,
                "items": { "type": "string", "pattern": "^(?!\\*+$).+$" }
              }
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_input_tokens", "max_usd"],
          "properties": {
            "max_input_tokens": { "type": "integer", "minimum": 1, "description": "Prompt tokens summed over the node's calls; the node is interrupted above it." },
            "max_usd": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "description": "OpenCode V2 compaction keys (server-wide) plus the orchestrator's own trigger.",
          "properties": {
            "auto": { "type": "boolean" },
            "keep_tokens": { "type": "integer", "minimum": 0, "description": "maps to compaction.keep.tokens" },
            "buffer": { "type": "integer", "minimum": 0 },
            "trigger_tokens": { "type": "integer", "minimum": 1, "description": "The orchestrator compacts the session once a call's context exceeds this (OpenCode 2.0.16 takes no compaction settings per session; the other keys describe the server config)." }
          }
        }
      }
    }
  }
}
