{
  "$schema": "./profile.schema.json",
  "schema": "profile/v1",
  "secrets": [
    { "env": true },
    { "command": ["security", "find-generic-password", "-s", "{item}", "-w"] }
  ],
  "opencode": {
    "url": "http://127.0.0.1:4096",
    "password_secret": "chargehand-opencode-password",
    "binary": "/opt/chargehand/bin/opencode",
    "version": "2.0.18"
  },
  "worker_root": "/srv/chargehand/work",
  "repository_roots": ["/srv/chargehand/work", "/path/to/your/repositories"],
  "default_preset": "default",
  "intake_model": "provider/small-model",
  "run_cap_usd": 1.0,
  "run_log": "runs/run-log.jsonl",
  "telemetry": {
    "otlp_endpoint": "https://langfuse.example.com/api/public/otel/v1/traces",
    "public_key_secret": "chargehand-langfuse-public-key",
    "secret_key_secret": "chargehand-langfuse-secret-key"
  },
  "http": {
    "port": 4300,
    "api_key_secret": "chargehand-api-key",
    "accounts": [
      {
        "name": "peer-harvest",
        "max_usd_per_month": 20.0,
        "public_clone": true
      }
    ]
  },
  "peer_clone": {
    "root": "/srv/chargehand/peer-clones",
    "max_repository_bytes": 200000000,
    "min_free_bytes": 5000000000,
    "token_secret": "chargehand-peer-clone-github-token"
  },
  "mcp_servers": {
    "memory-gateway": {
      "url": "https://mcp.example.internal/mcp",
      "headers": { "Authorization": "Bearer {secret:memory-gateway-token}" }
    },
    "team-notes": {
      "command": ["npx", "-y", "example-notes-mcp"],
      "env": { "NOTES_TOKEN": "{secret:team-notes-token}" }
    },
    "chronicle": {
      "url": "http://localhost:8080/sse",
      "transport": "sse"
    }
  },
  "memory": [
    {
      "name": "hindsight",
      "server": "memory-gateway",
      "namespace": "chargehand",
      "tools": {
        "recall": {
          "tool": "recall",
          "arguments": { "query": "{query}", "bank_id": "{namespace}", "budget": "low", "max_tokens": 1024 }
        },
        "retain": {
          "tool": "retain",
          "arguments": {
            "content": "{text}",
            "context": "{context}",
            "document_id": "{document_id}",
            "timestamp": "{timestamp}",
            "tags": "{tags}",
            "metadata": { "repository": "{repository}", "commit": "{commit}", "locators": "{locators}" },
            "bank_id": "{namespace}"
          }
        },
        "invalidate": {
          "tool": "invalidate_memory",
          "arguments": { "memory_id": "{id}", "reason": "{reason}", "bank_id": "{namespace}" }
        }
      },
      "retain": false
    },
    {
      "name": "chronicle",
      "server": "chronicle",
      "tools": {
        "recall": {
          "tool": "recall",
          "arguments": { "query": "{query}", "limit": "{max_facts}" },
          "results": { "path": "results", "id": "segment_id", "text": ["{date}: {summary}", "{date}: {text}"] }
        }
      }
    }
  ],
  "prices": {
    "provider/small-model": {
      "input": 0.1,
      "output": 0.5,
      "cache_read": 0.01,
      "cache_write": 0.125
    },
    "provider/large-model": {
      "input": 2.0,
      "output": 10.0,
      "cache_read": 0.2,
      "cache_write": 2.5
    }
  },
  "public_free": {
    "api_key_secret": "chargehand-public-free-key",
    "base_url": "https://gateway.example/anthropic",
    "github_token_secret": "chargehand-github-read-token",
    "replaces": ["cheap"],
    "intake_model": "mistral-free/mistral-medium-latest"
  },
  "pools": {
    "enabled": false,
    "time_zone": "UTC",
    "escalate_after": 2,
    "default_tier": "small",
    "owner_private_repos": ["owner/personal-notes", "other-account/*"],
    "restricted_path_segments": ["work"],
    "tiers": [
      { "name": "small", "models": ["mistral-free/mistral-medium-latest", "provider/small-model"] },
      { "name": "large", "models": ["provider/large-model"] }
    ],
    "routes": { "intake": "small", "driven": "small", "driven/L": "large", "review": "large", "code": "small", "code/L": "large" },
    "order": [
      { "name": "free", "kind": "free", "models": ["mistral-free/mistral-medium-latest"] },
      { "name": "credit", "kind": "monthly", "models": ["provider/small-model", "provider/large-model"], "total_usd": 100, "refill_day": 1, "no_training_models": ["*"] },
      { "name": "subscription", "kind": "weekly", "models": ["provider/large-model"], "refill_weekday": "sunday", "refill_time": "09:00", "no_training_models": ["*"] },
      { "name": "bought", "kind": "fixed", "models": ["provider/small-model", "provider/large-model"], "total_usd": 10 }
    ]
  },
  "models": {
    "provider/free-model": "mistral-free/mistral-medium-latest",
    "provider/worker-model": "provider/large-model",
    "provider/small-model": "provider/small-model",
    "provider/critic-model": "provider/large-model"
  }
}
