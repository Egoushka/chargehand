    <PackageId>Chargehand.Automation</PackageId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chargehand\Chargehand.csproj" />
    <ProjectReference Include="..\Chargehand.Driven\Chargehand.Driven.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chargehand.Tests" />
  </ItemGroup>

</Project>
