<Project>
  <Import Project="$(MSBuildThisFileDirectory)../Skeleton.props" />

  <!-- Every host publishes as a Native AOT binary (scripts/aot-smoke.sh, CI job aot). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
