  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chargehand.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" Version="2.2.0" />
  </ItemGroup>

</Project>
