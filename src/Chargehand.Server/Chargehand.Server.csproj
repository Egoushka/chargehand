<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chargehand\Chargehand.csproj" />
    <ProjectReference Include="..\Chargehand.Automation\Chargehand.Automation.csproj" />
    <ProjectReference Include="..\Chargehand.Driven\Chargehand.Driven.csproj" />
  </ItemGroup>

  <!-- The operator console (ADR 0056): the Vite build in web/console/dist, served at /console/. Without it (no `npm run build` yet) the server still builds and answers /console/ with a page that says so. -->
  <PropertyGroup>
    <ConsoleDist>$(MSBuildThisFileDirectory)..\..\web\console\dist\</ConsoleDist>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(ConsoleDist)index.html')">
    <EmbeddedResource Include="$(ConsoleDist)**\*" LogicalName="console/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chargehand.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" Version="2.2.0" />
  </ItemGroup>

</Project>
