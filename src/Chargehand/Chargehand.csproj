    <ProjectReference Include="..\Modules\Chargehand.Modules.Memory\Chargehand.Modules.Memory.csproj" />
    <ProjectReference Include="..\Modules\Chargehand.Modules.Oversight\Chargehand.Modules.Oversight.csproj" />
